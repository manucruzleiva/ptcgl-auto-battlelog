<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Writes rust/pab-core/tests/golden/: files made by the C# code itself (the plugin's LogStore and
    sealer, the tray's Json writer and upload state), which the Rust tray must read and write the same.
    Run: dotnet run (project tests/RustGoldens), argument rust/pab-core/tests/golden
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Tray/Logic/**/*.cs" Link="Logic/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../src/Plugin/Core/*.cs" Link="PluginCore/%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="$(RepoRoot)build/BuildInfo.targets" />
</Project>
