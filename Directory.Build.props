<Project>
  <!--
    Shared by every project. Release builds pass -p:Version=X.Y.Z (from the git tag); the value
    below is what local builds report.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.3.2-beta.3</Version>
    <Product>PTCGL Auto Battle Log</Product>
    <Company>manucruzleiva</Company>
    <Copyright>Copyright (c) 2026 manucruzleiva and PTCGL Auto Battle Log contributors. MIT License.</Copyright>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>

    <!-- Where OTA updates come from. Forks override these (or pass -p:RepoOwner=... on build). -->
    <RepoOwner Condition="'$(RepoOwner)' == ''">manucruzleiva</RepoOwner>
    <RepoName Condition="'$(RepoName)' == ''">ptcgl-auto-battlelog</RepoName>

    <BepInExVersion>5.4.23.3</BepInExVersion>
    <BepInExZip>BepInEx_win_x64_$(BepInExVersion).zip</BepInExZip>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>
</Project>
