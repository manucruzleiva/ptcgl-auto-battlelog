<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BepInEx 5 plugin for Pokemon TCG Live (Mono, x64). Built against BepInEx and Unity reference
    assemblies only: every game type is reached by reflection (see Core/GameApi.cs), so the game's
    own DLLs are not needed to build, and a game update does not require a rebuild.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>PtcglAutoBattleLog.Plugin</AssemblyName>
    <RootNamespace>PtcglAutoBattleLog</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(RepoRoot)lib\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RepoRoot)lib\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Import Project="$(RepoRoot)build\BuildInfo.targets" />

</Project>
