<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user app: never asks for admin (asInvoker). System DPI aware: sharp on the main screen, and
  scaled by Windows (slightly blurred) on a monitor with another scale. Per-monitor awareness would
  need WinForms' own opt-in in an app.config (<System.Windows.Forms.ApplicationConfigurationSection>
  DpiAwareness), which a single exe cannot ship; declared here alone, it makes Windows stop scaling
  while WinForms 4.8 still lays out every window at the main screen's DPI, so dialogs open too large
  or too small on the other monitors. Common controls v6 for the modern look of menus and dialogs.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="PtcglAutoBattleLog" type="win32" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>

  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0"
                        processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
