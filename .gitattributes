# Normalize line endings in the repository (LF); check text files out as the platform prefers.
* text=auto

# Windows scripts need CRLF (cmd.exe and Windows PowerShell 5.1); shell and Python scripts need LF
# (shebang lines).
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
*.py  text eol=lf

# Embedded in the exe (and the license files in the portable zip): the same bytes whichever OS
# builds it, so builds stay reproducible.
DISCLAIMER.md text eol=lf
THIRD-PARTY-NOTICES.md text eol=lf
LICENSE text eol=lf
licenses/*.txt text eol=lf

*.cs     text diff=csharp
*.csproj text
*.props  text
*.targets text
*.md     text diff=markdown

# Binaries: never touch line endings, never diff.
*.png binary
*.ico binary
*.jpg binary
*.gif binary
*.dll binary
*.exe binary
*.zip binary
*.pdb binary
